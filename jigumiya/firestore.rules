rules_version = '2';

// ─────────────────────────────────────────────────────────────
// 지금이야 Firestore 보안 규칙 (source of truth)
//
// 배포 방법:
//   cd ~/jigumiya/jigumiya
//   firebase deploy --only firestore:rules --project jigumiya
//
// 변경 이력:
//   - Phase 1  : users/{uid}/{document=**} 재귀 허용
//   - Phase 3-A: shared_products, price_drops 규칙 추가 (017.md §8-4)
//   - 019     : category_best 규칙 추가 (019.md §2-3)
//   - 019 통합: category_best_baby, event_best 규칙 추가 (아이고 공유 컬렉션)
//   - 019 통합: price_drops_baby 규칙 추가 (아이고 공유 컬렉션)
//   - 2026-05-05: event_best_jigumiya 규칙 추가 (지금이야 이벤트 D-7 윈도우)
//   - 2026-05-06: goldbox/{date} 규칙 추가 (매일 07:30 KST)
//   - 2026-05-06: coupang_pl/{date} 규칙 추가 (매일 07:30 KST)
// ─────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── 유저 전용 데이터 (Phase 1 ~) ───
    // users/{uid}/items/*       — 기존 추적 상품 (하위 호환 유지)
    // users/{uid}/tracked/*     — Phase 3-A 신규 (홈 추적 참조)
    // users/{uid}/favorites/*   — Phase 3-A 신규 (자주사는상품 참조)
    // 재귀 와일드카드로 위 3개 모두 본인만 R/W 허용
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ─── 전역 공유 상품 (Phase 3-A 신규) ───
    // shared_products/{productId}
    // - read : 모든 인증 유저 (피드/상세/홈 카드 메타데이터 조회)
    // - write: Phase 3-A 한시적 허용 (클라이언트 이중 쓰기 구간 필요)
    //
    // ⚠️ Phase 3-C 이관 시 반드시 `allow write: if false;`로 강화할 것
    //    서버(GitHub Actions + Firebase Admin SDK)만 쓰기 권한을 갖도록 하며
    //    Admin SDK는 보안 규칙을 우회하므로 서버 쓰기는 영향 없음.
    //    클라이언트는 이 시점부터 모든 가격 데이터를 읽기 전용으로만 사용.
    match /shared_products/{productId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ─── 카테고리 베스트 (019 신규) ───
    // category_best/{categoryId}
    // - read : 모든 인증 유저 (피드 탭 베스트 리스트 조회)
    // - write: 서버 전용 (Admin SDK bypass) — 클라이언트 쓰기 차단
    //
    // 갱신 주체: scripts/category-best-updater (GitHub Actions cron)
    // 문서 ID = String(categoryId)
    match /category_best/{categoryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── 카테고리 베스트 — 아이고 baby (019 통합 신규) ───
    // category_best_baby/{slug}
    // - read : 모든 인증 유저 (아이고 월령별 베스트 조회)
    // - write: 서버 전용 (Admin SDK bypass)
    //
    // 갱신 주체: 아이고 cron (baby 1~4그룹, 01:15 / 01:30 / 03:00 / 03:20 KST)
    // 문서 ID = slug (예: 'toys-0-3', 'clothes_6_12m')
    match /category_best_baby/{slug} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── 기념일 베스트 (019 통합 신규) ───
    // event_best/{eventSlug}
    // - read : 모든 인증 유저 (아이고 기념일 31개 조회)
    // - write: 서버 전용 (Admin SDK bypass)
    //
    // 갱신 주체: 아이고 event-best-updater cron (01:00 KST, minPrice=50000)
    // 문서 ID = eventSlug (예: 'birthday-1', 'parent-wedding')
    match /event_best/{eventSlug} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── 가격 하락 피드 (Phase 3-A 선반영, 실제 쓰기는 Phase 3-C부터) ───
    // price_drops/{dropId}
    // - read : 모든 인증 유저 (가격변동 탭 조회)
    // - write: 서버 전용 (Admin SDK bypass) — 클라이언트 쓰기 차단
    //
    // TTL 없음 (무제한 보관) — 스토리지 비용 대비 피드 가치 우선
    match /price_drops/{dropId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── 가격 하락 피드 — 아이고 baby (019 통합 신규) ───
    // price_drops_baby/{date}
    // - read : 모든 인증 유저 (아이고 가격변동 탭 조회)
    // - write: 서버 전용 (Admin SDK bypass)
    match /price_drops_baby/{date} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── 지금이야 기념일 베스트 (2026-05-05 후반 신규) ───
    // event_best_jigumiya/{slug} — 11개 이벤트 D-7 윈도우 (cron 02:35 KST)
    match /event_best_jigumiya/{slug} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── 골드박스 (2026-05-05 후반 신규) ───
    // goldbox/{YYYY-MM-DD} — 매일 07:30 KST 1콜
    match /goldbox/{date} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── 쿠팡 PL (2026-05-06 신규) ───
    // coupang_pl/{YYYY-MM-DD} — 매일 07:30 KST limit 100
    match /coupang_pl/{date} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ─── 공용 메타데이터 (019 §3-4 / 업데이트 알림) ───
    // meta/{docId} — 단일 문서 운영 카운터/설정 모음
    //   - meta/stats          : sharedProductCount 카운터 (019 §3-4)
    //   - meta/config_jigumiya: 지금이야 앱 업데이트 알림 설정
    //   - meta/config_aigo    : 아이고 앱 업데이트 알림 설정 (향후)
    // - read : 누구나 (인증 전 첫 실행 시점에 minRequiredVersion 체크 필요)
    //          버전 문자열만 노출되므로 보안상 영향 없음
    // - write: 서버 / 운영자 콘솔 전용
    match /meta/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
