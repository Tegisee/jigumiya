# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android/**
# Exception: google-services Gradle plugin 적용 상태 보존 (2026-05-11)
# 디렉토리 자체를 살려야 negation 적용됨 (git 명세: 부모 디렉토리 제외 시 자식 negation 불가).
# google-services.json은 비밀이라 계속 제외 — EAS Secret(FILE_BASE64)으로 주입.
!/android/
!/android/app/
!/android/build.gradle
!/android/app/build.gradle
