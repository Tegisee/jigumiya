name: Price Check Bot (DISABLED)

# 2026-05-02 완전 비활성화: 파일 확장자를 `.yml.disabled`로 변경 → GitHub Actions 미인식.
# Phase 3 shared-price-checker가 가격 체크를 전담하므로 legacy price-checker는 정식 폐기.
# 재활성화하려면 파일명을 `price-check.yml`로 되돌리면 됨 (히스토리 보존 목적 유지).

on:
  # 비활성화 유지 (2026-04-24 burst rate 과호출 → 긴급 차단).
  # 재활성화 조건: 019 §4-2 중복 처리 로직(category_best 캐시) 구현 완료 후.
  #
  # 신규 스케줄 (019 §4-1 기준, 비활성 상태로만 기록):
  #   - 04:00 KST (19:00 UTC): shared_products 가격 체크 (category_best 중복 productId 제외)
  #   → category-best-updater(02:00 KST, 약 40분 소요)와 1시간 20분 간격 — 시간 충돌 없음
  #
  # 폐기된 이전 스케줄:
  #   - 08:00 / 12:00 / 20:00 KST (Phase 2 시점)
  #   - 08:00 / 12:00 / 20:00 KST (2026-04-24 오후 시간 분리 시도 — 야간 burst rate 사고로 폐기)
  #
  # 비활성화 이력:
  #   - 2026-04-21: Rate Limit 2회 초과 → 2026-04-22 자연 해제
  #   - 2026-04-23: 018 Resolver 배포 후 재활성화
  #   - 2026-04-24: burst rate 과호출 의심 → 긴급 차단 (현재)
  # schedule:
  #   - cron: '0 19 * * *'   # 04:00 KST (019 §4-1)
  workflow_dispatch: {}

jobs:
  price-check:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '24'

      - name: Install dependencies
        working-directory: scripts/price-checker
        run: npm install

      - name: Build TypeScript
        working-directory: scripts/price-checker
        run: npx tsc

      - name: Run price checker
        working-directory: scripts/price-checker
        env:
          FIREBASE_SERVICE_ACCOUNT_KEY: ${{ secrets.FIREBASE_SERVICE_ACCOUNT_KEY }}
          COUPANG_ACCESS_KEY: ${{ secrets.COUPANG_ACCESS_KEY }}
          COUPANG_SECRET_KEY: ${{ secrets.COUPANG_SECRET_KEY }}
        run: node dist/index.js
